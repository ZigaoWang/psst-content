# Psst nightly database backup (see server/backup.sh). 03:17 UTC, logged to /var/log/psst-backup.log.
17 3 * * * root /usr/local/bin/psst-backup >> /var/log/psst-backup.log 2>&1
# Every Sunday, restore the latest backup into a scratch database and check it matches (docs/RESTORE.md).
47 4 * * 0 root /usr/local/bin/psst-restore-test >> /var/log/psst-backup.log 2>&1
