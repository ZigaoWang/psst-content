{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psst.zigao.wang/format/v2/city.schema.json",
  "title": "Psst city pack, format 2",
  "description": "Every published place in one city, with its published facts and photos. Coordinates are WGS-84. Photo files are at <content host>/images/<file>.",
  "type": "object",
  "required": ["formatVersion", "cityId", "places"],
  "properties": {
    "formatVersion": {"const": 2},
    "cityId": {"type": "string"},
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "size", "lat", "lon", "location", "facts"],
        "properties": {
          "id": {"type": "string", "pattern": "^pl_[0-9a-hjkmnp-tv-z]{10}$"},
          "name": {"type": "string", "minLength": 1},
          "localName": {
            "type": ["object", "null"],
            "required": ["lang", "name"],
            "properties": {"lang": {"type": "string"}, "name": {"type": "string", "minLength": 1}}
          },
          "names": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
          "kind": {"type": "string"},
          "size": {"enum": ["small", "medium", "large"]},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lon": {"type": "number", "minimum": -180, "maximum": 180},
          "location": {
            "type": "object",
            "required": ["source", "ref", "license"],
            "properties": {
              "source": {"enum": ["wikidata", "osm"]},
              "ref": {"type": "string"},
              "license": {"enum": ["CC0-1.0", "ODbL-1.0"]}
            }
          },
          "countryCode": {"type": ["string", "null"]},
          "districtId": {"type": ["string", "null"]},
          "neighborhoodId": {"type": ["string", "null"]},
          "images": {
            "type": "array",
            "description": "Optional; in display order. Older apps ignore it.",
            "items": {
              "type": "object",
              "required": ["id", "kind", "alt", "focus", "full", "thumb", "credit"],
              "properties": {
                "id": {"type": "string", "pattern": "^im_[0-9a-hjkmnp-tv-z]{10}$"},
                "kind": {"enum": ["photo", "historic"]},
                "year": {"type": ["integer", "null"]},
                "alt": {"type": "string", "minLength": 10, "maxLength": 300},
                "focus": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2},
                "full": {"$ref": "#/$defs/rendition"},
                "thumb": {"$ref": "#/$defs/rendition"},
                "credit": {
                  "type": "object",
                  "required": ["author", "license", "sourceUrl"],
                  "properties": {
                    "author": {"type": "string", "minLength": 1},
                    "authorUrl": {"type": ["string", "null"]},
                    "license": {"type": "string", "minLength": 1},
                    "licenseUrl": {"type": ["string", "null"]},
                    "sourceUrl": {"type": "string", "pattern": "^https://"},
                    "source": {"enum": ["commons", "geograph", "flickr", "archive", "owner"]},
                    "title": {"type": ["string", "null"]}
                  }
                }
              }
            }
          },
          "facts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "category", "veracity", "headline", "short", "long", "sources"],
              "properties": {
                "id": {"type": "string", "pattern": "^fa_[0-9a-hjkmnp-tv-z]{10}$"},
                "category": {"type": "string"},
                "veracity": {"enum": ["fact", "legend", "disputed"]},
                "headline": {"type": "string", "minLength": 1, "maxLength": 60},
                "short": {"type": "string", "minLength": 1, "maxLength": 220},
                "long": {"type": "string", "minLength": 300, "maxLength": 1200},
                "tags": {"type": "array", "items": {"type": "string"}},
                "researchedOn": {"type": ["string", "null"]},
                "lastVerified": {"type": ["string", "null"]},
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["title", "publisher", "url"],
                    "properties": {
                      "title": {"type": "string"},
                      "publisher": {"type": "string"},
                      "url": {"type": "string", "pattern": "^https://"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rendition": {
      "type": "object",
      "required": ["file", "width", "height"],
      "properties": {
        "file": {"type": "string", "pattern": "^[0-9a-f]{24}\\.jpg$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    }
  }
}
